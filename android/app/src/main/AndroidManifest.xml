<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Kept for v1 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Cypher always-listening (added back after v1): foreground service
         (microphone type) so OpenWakeWord can listen with the app closed,
         and the notification permission for its persistent notification. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Removed for v1 (held until testing is done):
         SEND_SMS, READ_CONTACTS, WRITE_CONTACTS, READ_CALENDAR, WRITE_CALENDAR,
         ACCESS_FINE_LOCATION, ACCESS_COARSE_LOCATION, SET_ALARM, USE_EXACT_ALARM,
         QUERY_ALL_PACKAGES, WAKE_LOCK
         (FOREGROUND_SERVICE, FOREGROUND_SERVICE_MICROPHONE and POST_NOTIFICATIONS
         came back for Cypher always-listening.) -->
    <application
        android:label="Clawzilla"
        android:icon="@mipmap/ic_launcher"
        android:networkSecurityConfig="@xml/network_security_config"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- "Talk to Cypher" deep link: clawzilla://talk opens the chat
                 already listening. Used by the side-button assistant
                 session and by any shortcut that wants to start talking. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="clawzilla" android:host="talk" />
            </intent-filter>
            <!-- Assist gesture fallback: some launchers send ACTION_ASSIST
                 straight at the activity instead of going through the
                 VoiceInteractionService. -->
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Digital assistant (side button): these are what make Clawzilla
             appear in Settings → Advanced features → Side button →
             Long press → Digital assistant. The service itself is an empty
             subclass; the session opens the app on clawzilla://talk.
             No new permission: BIND_VOICE_INTERACTION only lets the OS
             bind to these services, it grants the app nothing. -->
        <service
            android:name=".CypherVoiceInteractionService"
            android:label="Clawzilla"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION">
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
            <meta-data
                android:name="android.voice_interaction"
                android:resource="@xml/voice_interaction_service" />
        </service>
        <service
            android:name=".CypherVoiceInteractionSessionService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION" />
        <!-- Stub recognition service: the framework requires one to be
             declared for the assistant component to be valid. Clawzilla
             does its speech recognition in the chat screen, not here. -->
        <service
            android:name=".CypherRecognitionService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION">
            <intent-filter>
                <action android:name="android.service.voice.RecognitionService" />
            </intent-filter>
        </service>

        <!-- NOTE (carried over from the original): the foreground service is
             declared by the flutter_foreground_task plugin's own manifest.
             A build-time merged-manifest check is still needed: plugins can
             re-add permissions this draft removes. -->

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
</manifest>
