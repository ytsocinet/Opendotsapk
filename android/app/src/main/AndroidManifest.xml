<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Kept for v1 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Cypher always-listening (added back after v1): foreground service
         (microphone type) so OpenWakeWord can listen with the app closed,
         and the notification permission for its persistent notification.
         Background mode (build #90) uses the same service with the
         dataSync type while Cypher works on a long reply. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Live location (added back Nov 11, 2026, when Aaron approved it so
         the model can know where he is and the temperature). Requested at
         runtime by the location service; coarse covers city-level weather
         when fine is declined. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Silent tools (build #110, Nov 16, 2026): Aaron wants Cypher to
         send with no tap, so these four tools use privileged APIs
         directly instead of system Intents. All four are dangerous
         permissions — the Dart side requests each at runtime on first
         use (permission_handler, mirroring the location service), and a
         denial fails gracefully with a message, never a crash.
         - SEND_SMS: SmsManager sends the text. The native side also
           looks a contact name up to a number, so READ_CONTACTS is
           declared too (the contacts request covers both).
         - READ_CALENDAR + WRITE_CALENDAR: ContentResolver insert. Both
           must be declared: permission_handler's calendarFullAccess
           requests the pair together and returns denied immediately if
           either is missing from the manifest.
         - READ_CONTACTS + WRITE_CONTACTS: contact insert (write) and
           the SMS name lookup (read); one contacts request covers both.
         - SET_ALARM is normal (auto-granted). USE_EXACT_ALARM is normal
           too (auto-granted on Android 13+), and SCHEDULE_EXACT_ALARM is
           the user-granted special permission for Android 12 — both are
           declared so AlarmManager exact alarms work on every version;
           on this phone (Android 14) USE_EXACT_ALARM already covers it.
         - WAKE_LOCK (normal, auto-granted): the alarm receiver holds a
           partial wake lock while the alarm tone plays, so the phone
           stays awake until it is dismissed. Sideloaded debug APK, so
           no Play Store review concern. -->
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <uses-permission android:name="android.permission.SET_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- All-files access (build #95): listing a shared-storage folder
         with raw file paths needs this on Android 11+ — without the
         grant, Directory.list() yields nothing and Projects reports a
         folder with files in it as empty (the "blink" bug: the folder
         held a 25-byte file the app could not see). The Projects screen
         requests the grant when a picked folder lists empty; the user
         flips the toggle in Settings, there is no runtime dialog for
         it. Sideloaded debug APK, so no Play Store review concern. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <!-- Package visibility (Android 11+): listing launchable apps for the
         Connected apps picker needs this narrow queries entry for the
         launcher intent. It is NOT the broad QUERY_ALL_PACKAGES permission,
         which stays out for v1. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!-- Removed for v1 (held until testing is done):
         QUERY_ALL_PACKAGES
         (FOREGROUND_SERVICE, FOREGROUND_SERVICE_MICROPHONE and POST_NOTIFICATIONS
         came back for Cypher always-listening; ACCESS_FINE_LOCATION and
         ACCESS_COARSE_LOCATION came back for live location;
         MANAGE_EXTERNAL_STORAGE came back in build #95 for the Projects
         folder — see above; SEND_SMS, READ_CONTACTS, WRITE_CONTACTS,
         READ_CALENDAR, WRITE_CALENDAR, SET_ALARM, USE_EXACT_ALARM,
         SCHEDULE_EXACT_ALARM and WAKE_LOCK came back in build #110 for
         the four silent tools — see above.) -->
    <application
        android:label="Clawzilla"
        android:icon="@mipmap/ic_launcher"
        android:networkSecurityConfig="@xml/network_security_config"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- "Talk to Cypher" deep link: clawzilla://talk opens the chat
                 already listening. Used by the side-button assistant
                 session and by any shortcut that wants to start talking. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="clawzilla" android:host="talk" />
            </intent-filter>
            <!-- Assist gesture fallback: some launchers send ACTION_ASSIST
                 straight at the activity instead of going through the
                 VoiceInteractionService. -->
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Digital assistant (side button): these are what make Clawzilla
             appear in Settings → Advanced features → Side button →
             Long press → Digital assistant. The service itself is an empty
             subclass; the session opens the app on clawzilla://talk.
             No new permission: BIND_VOICE_INTERACTION only lets the OS
             bind to these services, it grants the app nothing. -->
        <service
            android:name=".CypherVoiceInteractionService"
            android:label="Clawzilla"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION">
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
            <meta-data
                android:name="android.voice_interaction"
                android:resource="@xml/voice_interaction_service" />
        </service>
        <service
            android:name=".CypherVoiceInteractionSessionService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION" />
        <!-- Stub recognition service: the framework requires one to be
             declared for the assistant component to be valid. Clawzilla
             does its speech recognition in the chat screen, not here. -->
        <service
            android:name=".CypherRecognitionService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION">
            <intent-filter>
                <action android:name="android.service.voice.RecognitionService" />
            </intent-filter>
        </service>

        <!-- flutter_foreground_task does NOT declare its service — the host
             app must. Android 14+ requires android:foregroundServiceType
             to be declared, and ours is microphone (wake-word listening)
             plus dataSync (background mode, build #90 — Cypher working on
             a long reply). Without this the service silently never starts:
             the toggle flips on, then back off, with "foreground service
             did not start". A build-time merged-manifest check is still
             needed: plugins can re-add permissions this draft removes. -->
        <service
            android:name="com.pravera.flutter_foreground_task.service.ForegroundService"
            android:foregroundServiceType="microphone|dataSync"
            android:exported="false" />

        <!-- Alarm receiver (build #110): AlarmManager fires this when a
             silent set_alarm goes off. Not exported — only explicit
             intents from this app reach it — and no intent-filter, for
             the same reason. It plays the alarm tone on loop and posts
             the dismiss notification; it holds a partial wake lock while
             ringing. -->
        <receiver
            android:name=".AlarmReceiver"
            android:exported="false" />

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
</manifest>
